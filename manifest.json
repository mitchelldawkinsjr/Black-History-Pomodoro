{
  "manifest_version": 3,
  "name": "Paint Pomodoro",
  "version": "1.0.0",
  "description": "A Pomodoro timer that covers your screen in watercolor when it's time to rest.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "Paint Pomodoro"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["alarms", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://collectionapi.metmuseum.org/*",
    "https://images.metmuseum.org/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/inject-overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "overlay/overlay.html",
        "overlay/overlay.js",
        "overlay/overlay.css",
        "shared/met-theme.css",
        "overlay/paint-sketch.js",
        "overlay/watercolor.js",
        "overlay/color-agents.js",
        "overlay/mark-utils.js",
        "lib/p5.min.js",
        "data/prompts.json"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
