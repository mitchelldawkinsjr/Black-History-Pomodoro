# Black History API (https://blackhistoryapi.io). Leave empty to serve reviewed fallbacks only.
BLACK_HISTORY_API_KEY=
BLACK_HISTORY_BASE_URL=https://rest.blackhistoryapi.io/v2
# Path (relative to the base URL) of the random-fact endpoint.
BLACK_HISTORY_FACT_PATH=/fact/random

# Public origin of this API: used to build /v1/media/:assetId URLs and as an allowed CORS origin.
PUBLIC_API_ORIGIN=http://localhost:8080

DISCOVERY_CACHE_TTL_SECONDS=604800
IMAGE_MATCH_ATTEMPTS=16
RATE_LIMIT_PER_MINUTE=30
PORT=8080

# Optional overrides
# REVIEWED_FALLBACKS_PATH=../data/reviewed-fallbacks.json   (FALLBACKS_PATH is accepted as an alias)
# MEDIA_CACHE_DIR=./data/cache/media
# TRUST_PROXY=true   # set behind Nginx Proxy Manager so per-IP rate limiting sees client IPs
