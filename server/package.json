{
  "name": "black-history-pomodoro-api",
  "version": "1.0.0",
  "private": true,
  "description": "Project API for Black History Pomodoro: serves reviewed, sourced historical discoveries and approved media.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
